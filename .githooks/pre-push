#!/bin/sh
set -eu
if [ -x .tools/node/node.exe ]; then qq_node=.tools/node/node.exe; else qq_node=node; fi
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_ref" in
    refs/heads/production-baseline|refs/heads/codex/group-personas|refs/tags/baseline/*)
      echo 'Private pre-publication history must not be pushed.' >&2; exit 1 ;;
  esac
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  "$qq_node" scripts/check-publication.mjs --ref "$local_oid"
done
